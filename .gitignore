# Local xtool (WSL) build setup — not part of the Xcode/CI build
/.bsp/
/.build/
/xtool/
/*.ipa
/Package.swift
/Package.resolved
/xtool.yml
/Config/
/scripts/
/iPadn-iOS/vendor/ZIPFoundation/

# Local copy of build_native_install.sh with LF line endings for WSL
/iPadn-iOS/scripts/.bni.sh

# Private edition isolation: never track artifacts, certs, profiles or signed/test IPAs
/artifacts/
/Documents/
*.p12
!/iPadn-iOS/iPadnTests/Fixtures/localhost-test-only.p12
*.mobileprovision
signing.json
*.log

# MACN-cheese (macOS port) build output and fetched deps
/mac/.build/
/mac/deps/

# WINN / LINCE (Tauri desktop) build output
/desktop/node_modules/
/desktop/dist/
/desktop/src-tauri/target/
/desktop/src-tauri/gen/
/desktop/.build/
/desktop/src-tauri/binaries/*
!/desktop/src-tauri/binaries/README.md
